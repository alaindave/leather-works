{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "..",
    "outDir": "../../../dist-electron",
    "skipLibCheck": true,
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "references": [
    {
      "path": "../../../shared"
    }
  ],
  "include": [
    "./**/*.ts",
    "../common/**/*.ts",
    "../../../shared/**/*.ts",
    "../../../**/*.d.ts"
  ],
  "exclude": ["node_modules", "../../../dist-electron"]
}
